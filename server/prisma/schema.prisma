generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TimeOffRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum ShiftClaimRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum ShiftNoteType {
  INFO
  TODO
}

// Why an employee isn't working a shift they were originally scheduled for.
// Set alongside opening the shift (see lib/absence.ts) so it can still be
// picked up by a coworker, while the original employee's payroll hours are
// tracked separately — VACATION is fully paid and nets out against the
// month's expected hours, the other three create a shortfall carried into
// next month's expected hours (see routes/reports.ts).
enum AbsenceType {
  SICK
  VAB
  UNPAID_LEAVE
  VACATION
}

enum AbsenceEventKind {
  ABSENCE
  COVERAGE
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  shifts               Shift[]                @relation("AssignedShifts")
  originalShifts       Shift[]                @relation("OriginalShifts")
  absenceShifts        Shift[]                @relation("AbsenceShifts")
  absenceEvents        AbsenceEvent[]
  recurringAssignments RecurringAssignment[]
  scheduleOverrides    ScheduleOverride[]
  timeOffRequests      TimeOffRequest[]
  shiftClaimRequests   ShiftClaimRequest[]
  shiftNotes           ShiftNote[]            @relation("AuthoredNotes")
  completedShiftNotes  ShiftNote[]            @relation("CompletedNotes")
}

// A named standard shift (e.g. Opening/Day/Closing) with times that can differ
// between weekdays and weekends, and may run past midnight.
model ShiftTemplate {
  id                String  @id @default(cuid())
  name              String  @unique
  weekdayStart      String // "HH:mm"
  weekdayEnd        String // "HH:mm"
  weekdayEndNextDay Boolean @default(false)
  weekendStart      String // "HH:mm"
  weekendEnd        String // "HH:mm"
  weekendEndNextDay Boolean @default(false)

  shifts               Shift[]
  recurringAssignments RecurringAssignment[]
}

// The employee's standing pattern across a repeating 14-day cycle: what
// applies on a given cycle day. cycleDay 0-6 is "week 1" (0 = Monday, even
// ISO week numbers), 7-13 is "week 2" (odd ISO week numbers) — computed
// fresh from the real calendar every time (see lib/cycle.ts), so two
// employees' patterns (e.g. a 7-on/7-off rotation) can be offset from each
// other. This is what the rolling 2-week schedule is generated from.
//
// Each slot is either a standard template (shiftTemplateId set) or a custom
// fixed time range (customStartTime/customEndTime set) — exactly one of the
// two, enforced at the application layer.
model RecurringAssignment {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleDay          Int // 0-13
  shiftTemplateId   String?
  shiftTemplate     ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  customStartTime   String? // "HH:mm"
  customEndTime     String? // "HH:mm"
  customEndNextDay  Boolean        @default(false)

  @@unique([userId, cycleDay])
}

// Marks a (user, calendar day) as explicitly overridden — created whenever an
// admin deletes a shift — so the rolling-schedule generator never recreates a
// shift there (e.g. a sick day stays empty instead of being auto-refilled).
model ScheduleOverride {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime

  @@unique([userId, date])
}

// A planned shift on the schedule (who should be working when). userId is
// null when the shift is "open" — the original employee had a time-off
// request approved, and anyone without a conflicting shift can claim it.
model Shift {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation("AssignedShifts", fields: [userId], references: [id], onDelete: SetNull)
  originalUserId  String?
  originalUser    User?          @relation("OriginalShifts", fields: [originalUserId], references: [id], onDelete: SetNull)
  startsAt        DateTime
  endsAt          DateTime
  notes           String?
  shiftTemplateId String?
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  absenceType     AbsenceType?
  // Who the shift's *current* absence applies to — reflects only the latest
  // mark-absence action (overwritten if the shift changes hands again, e.g.
  // a coworker claims it and is later marked absent themselves). Used for the
  // live UI only (badges, "täcker X" labels); reports use the permanent
  // AbsenceEvent log below instead, since that survives being overwritten.
  absenceUserId   String?
  absenceUser     User?          @relation("AbsenceShifts", fields: [absenceUserId], references: [id], onDelete: SetNull)
  // When the *current* absence was marked — also just for the live UI.
  absenceMarkedAt DateTime?
  fromRecurring   Boolean        @default(false)
  createdAt       DateTime       @default(now())

  timeOffRequests   TimeOffRequest[]
  claimRequests     ShiftClaimRequest[]
  shiftNotes        ShiftNote[]
  absenceEvents     AbsenceEvent[]

  // Prevents the same employee ever getting two shifts starting at the exact
  // same instant — including two concurrent rolling-schedule generations
  // racing each other. (Open shifts, userId null, aren't constrained against
  // each other — Postgres treats each NULL as distinct in a unique index.)
  // This index also covers the userId+startsAt lookups elsewhere in the app.
  @@unique([userId, startsAt])
}

// A request from the shift's own employee to be taken off it. Approving one
// opens the shift up for another employee to claim (see Shift.userId) rather
// than deleting it, and also records a ScheduleOverride for the original
// employee so the rolling generator doesn't re-fill their slot that day.
model TimeOffRequest {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId       String?
  shift         Shift?               @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftStartsAt DateTime
  shiftEndsAt   DateTime
  status        TimeOffRequestStatus @default(PENDING)
  reason        String?
  createdAt     DateTime             @default(now())
  resolvedAt    DateTime?

  @@index([userId])
  @@index([shiftId])
}

// A request from an employee to take an open (unassigned) shift. Admin picks
// who gets it — approving one request assigns the shift to that user and
// automatically denies every other pending request for the same shift.
model ShiftClaimRequest {
  id            String                  @id @default(cuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId       String?
  shift         Shift?                  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftStartsAt DateTime
  shiftEndsAt   DateTime
  status        ShiftClaimRequestStatus @default(PENDING)
  createdAt     DateTime                @default(now())
  resolvedAt    DateTime?

  @@index([userId])
  @@index([shiftId])
}

// A note left on a specific shift instance, readable/writable by that shift's
// employee, anyone with an overlapping shift the same time, and admins.
// TODO notes can be checked off by anyone with that access, not just the author.
model ShiftNote {
  id            String        @id @default(cuid())
  shiftId       String
  shift         Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  authorId      String
  author        User          @relation("AuthoredNotes", fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  type          ShiftNoteType @default(INFO)
  completed     Boolean       @default(false)
  completedById String?
  completedBy   User?         @relation("CompletedNotes", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  @@index([shiftId])
}

// Marks a calendar month ("YYYY-MM") as having had its hours sent to the
// salary office. Before a month is locked, any absence marked for a shift in
// it just corrects that month's own reported hours directly. Once locked,
// a later absence change for a shift still in that month can no longer alter
// what was already submitted, so it's carried into the following month's
// adjustment instead (see routes/reports.ts).
model PayrollLock {
  id       String   @id @default(cuid())
  month    String   @unique // "YYYY-MM"
  lockedAt DateTime @default(now())
}

// A permanent, append-only record of each absence-related payroll event on a
// shift, kept separate from Shift.absenceType/absenceUserId (which only
// reflect the *current* state, for the live UI) because a shift can change
// hands more than once — e.g. Edwin is marked Sjuk, Andreas claims it, then
// Andreas is *also* marked Sjuk for that same shift. Each handoff must keep
// its own hours so reports stay correct no matter how many times a shift is
// reassigned: an ABSENCE event is recorded for whoever is marked absent (the
// hours they didn't work), a COVERAGE event for whoever then claims the
// opened shift (the hours they did work, that weren't part of their own
// original schedule). See routes/reports.ts for how these combine.
model AbsenceEvent {
  id          String           @id @default(cuid())
  shiftId     String
  shift       Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    User             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind        AbsenceEventKind
  absenceType AbsenceType
  hours       Float
  shiftDate   DateTime // the shift's startsAt, i.e. which month this event belongs to
  markedAt    DateTime         @default(now())

  @@index([shiftId])
  @@index([employeeId, shiftDate])
}
